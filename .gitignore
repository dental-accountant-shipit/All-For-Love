node_modules/
.next/
out/
build/
dist/

# Compiled Cloud Functions. The functions compile the pure engine from ../src
# alongside their own source, so the output tree mirrors the repository —
# hence both paths.
functions/lib/
src/**/*.js

# Secrets and local configuration — never committed
.env
.env.local
.env*.local
*serviceAccount*.json
*firebase-adminsdk*.json

# Local development: the emulator's database and logs. Yours, this laptop's,
# and nobody else's business.
.local-data/
.local-*.log
firebase-export-*/

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# Font files are committed on purpose: OFL-licensed, and a build that needs
# somebody else's CDN is a build that fails on a train.
!src/app/fonts/*.woff2

# Reference workbooks live in Google Drive, never here
*.xlsx
*.xlsm
*.xls

.DS_Store
*.tsbuildinfo
coverage/

# Local scratch left by the sync tooling — safe to delete
_afl-*.zip
_unpack*/
_stale-git-locks/
